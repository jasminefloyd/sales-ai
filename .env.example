# AI Sales OS environment template
#
# Copy this file to .env.local and replace placeholders with real values.
# Do not commit .env.local or any file containing credentials.
#
# The implementation plan requires Sales OS environment variables to use
# the SALES_OS_ prefix. Provider secrets must remain server-side.

# -----------------------------------------------------------------------------
# Application / tenant
# -----------------------------------------------------------------------------
SALES_OS_TENANT_ID=sales_os
SALES_OS_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Supabase — browser-safe values may be used by the frontend; the service key
# is server-only and must never be exposed to the browser.
# -----------------------------------------------------------------------------
SALES_OS_SUPABASE_URL=https://your-project.supabase.co
SALES_OS_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SALES_OS_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# -----------------------------------------------------------------------------
# Required V1 providers
# -----------------------------------------------------------------------------
SALES_OS_OPENAI_API_KEY=replace-with-openai-api-key
SALES_OS_OPENAI_MODEL=replace-with-openai-model-id
SALES_OS_ANTHROPIC_API_KEY=replace-with-anthropic-api-key
SALES_OS_ANTHROPIC_MODEL=replace-with-anthropic-model-id
SALES_OS_ANTHROPIC_INPUT_COST_PER_MILLION_TOKENS=replace-with-current-input-rate
SALES_OS_ANTHROPIC_OUTPUT_COST_PER_MILLION_TOKENS=replace-with-current-output-rate
SALES_OS_EXA_API_KEY=replace-with-exa-api-key
SALES_OS_FIRECRAWL_API_KEY=replace-with-firecrawl-api-key
SALES_OS_CRON_SECRET=replace-with-random-scheduler-secret
SALES_OS_HUNTER_API_KEY=replace-with-hunter-api-key

# -----------------------------------------------------------------------------
# Gmail OAuth application — required for email execution.
# User/mailbox authorization is an application/runtime concern and must not
# be hard-coded here unless the implementation explicitly requires it.
# -----------------------------------------------------------------------------
SALES_OS_GMAIL_CLIENT_ID=replace-with-gmail-oauth-client-id
SALES_OS_GMAIL_CLIENT_SECRET=replace-with-gmail-oauth-client-secret
SALES_OS_GMAIL_ACCESS_TOKEN=replace-with-server-side-oauth-access-token
SALES_OS_GMAIL_USER=me

# -----------------------------------------------------------------------------
# Community discovery / execution — configure only if the selected Reddit or
# other supported community integration requires credentials.
# -----------------------------------------------------------------------------
SALES_OS_REDDIT_CLIENT_ID=
SALES_OS_REDDIT_CLIENT_SECRET=
SALES_OS_REDDIT_USER_AGENT=

# -----------------------------------------------------------------------------
# Optional per-product providers
# -----------------------------------------------------------------------------
SALES_OS_POSTHOG_API_KEY=
SALES_OS_POSTHOG_HOST=
SALES_OS_STRIPE_SECRET_KEY=
SALES_OS_STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Optional runtime configuration. Exact usage/defaults must be established by
# the implementing service before these values become operational contracts.
# -----------------------------------------------------------------------------
SALES_OS_LOG_LEVEL=info
