{
  "name": "sales-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,json,html}\" \"supabase/tests/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,json,html}\" \"supabase/tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.8",
    "lucide-react": "0.460.0",
    "pdfjs-dist": "^4.10.38",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "9.0.1",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}
